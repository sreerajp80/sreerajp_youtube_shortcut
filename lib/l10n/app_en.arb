  "helpFaqPinSetup": "How do I set up a Security PIN?",
  "@helpFaqPinSetup": { "description": "FAQ question: How to setup PIN." },
  "helpFaqPinSetupAns": "Go to Settings → Privacy & Security, tap 'Set PIN', and enter a 4 to 6 digit security code. Once configured, you can enable App Lock and Private Shortcut Lock.",
  "@helpFaqPinSetupAns": { "description": "FAQ answer: How to setup PIN." },
  "helpFaqBiometrics": "Does the app support Fingerprint and Face Unlock?",
  "@helpFaqBiometrics": { "description": "FAQ question: Biometric support." },
  "helpFaqBiometricsAns": "Yes. When biometric hardware is available on your Android device, you can tap the fingerprint icon on the lock screen for instant authentication.",
  "@helpFaqBiometricsAns": { "description": "FAQ answer: Biometric support." },
  "helpSecPrivateVault": "Private Shortcuts Vault",
  "@helpSecPrivateVault": { "description": "Section header for Private Vault in help guide." },
  "helpFaqPrivateShortcuts": "What does marking a shortcut as 'Private' do?",
  "@helpFaqPrivateShortcuts": { "description": "FAQ question: Private shortcuts." },
  "helpFaqPrivateShortcutsAns": "When 'Lock Private Shortcuts' is enabled, any shortcut flagged as private is hidden from the main list. You must authenticate to reveal and launch private shortcuts.",
