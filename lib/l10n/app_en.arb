  "helpFaqAddHow": "How do I add a new shortcut?",
  "@helpFaqAddHow": { "description": "FAQ question: How to add a shortcut." },
  "helpFaqAddHowAns": "Tap the '+' floating action button on the home screen. Enter a memorable shortcut name, and paste any YouTube link or enter a channel handle. The app automatically cleans and formats the destination URL.",
  "@helpFaqAddHowAns": { "description": "FAQ answer: How to add a shortcut." },
  "helpFaqClipboard": "How does clipboard paste detection work?",
  "@helpFaqClipboard": { "description": "FAQ question: Clipboard detection." },
  "helpFaqClipboardAns": "When you copy a YouTube link in your browser or YouTube app and open Add Shortcut, the app checks your clipboard locally and presents a 1-tap 'Paste' button to fill the URL instantly.",
  "@helpFaqClipboardAns": { "description": "FAQ answer: Clipboard detection." },
  "helpSecCustomizing": "Customizing & Organizing",
  "@helpSecCustomizing": { "description": "Section header for Customizing & Organizing in help guide." },
  "helpFaqColorsIcons": "Can I customize card colors and icons?",
  "@helpFaqColorsIcons": { "description": "FAQ question: Colors and icons." },
  "helpFaqColorsIconsAns": "Yes! When creating or editing a shortcut, expand the Custom Accent Color and Custom Icon sections to assign distinctive colors and icons (like Star, Play, Music, Gaming, Tech, and more).",
  "@helpFaqColorsIconsAns": { "description": "FAQ answer: Colors and icons." },
  "helpFaqTags": "How do tags work?",
  "@helpFaqTags": { "description": "FAQ question: How tags work." },
  "helpFaqTagsAns": "Add tags like '#Music', '#Tutorial', or '#News' to categorize your shortcuts. You can tap on tags or use the search bar to filter your shortcut library in real time.",
  "@helpFaqTagsAns": { "description": "FAQ answer: How tags work." },
  "helpFaqReorder": "How do I reorder shortcuts on the home screen?",
  "@helpFaqReorder": { "description": "FAQ question: How to reorder." },
  "helpFaqReorderAns": "Ensure your sort mode is set to 'Manual order' (tap the sort icon in the app bar), then choose 'Reorder shortcuts' from the overflow menu. Long-press and drag cards into your desired position.",
  "@helpFaqReorderAns": { "description": "FAQ answer: How to reorder." },

  "helpHandlesTitle": "Channel Handles & Live Streams",
  "@helpHandlesTitle": { "description": "AppBar title for Handles help screen." },
  "helpHandlesIntro": "Understand how SreerajP YouTube Shortcuts formats channel handles and routes directly to live streams or channels.",
  "@helpHandlesIntro": { "description": "Intro text for Handles help screen." },
  "helpSecHandleSyntax": "Handle Syntax & Formatting",
  "@helpSecHandleSyntax": { "description": "Section header for Handle Syntax in help guide." },
  "helpFaqHandleFormat": "What format should I use for handles?",
  "@helpFaqHandleFormat": { "description": "FAQ question: Handle format." },
  "helpFaqHandleFormatAns": "You can enter either '@ChannelHandle' or simply 'ChannelHandle'. The app validates the handle shape (3–30 letters, numbers, dots, dashes, underscores) and converts it to https://www.youtube.com/@handle/live.",
  "@helpFaqHandleFormatAns": { "description": "FAQ answer: Handle format." },
  "helpSecHandleBehavior": "Live vs Non-Live Channels",
  "@helpSecHandleBehavior": { "description": "Section header for Live vs Non-Live in help guide." },
  "helpFaqLiveRouting": "What happens if the channel is not live?",
  "@helpFaqLiveRouting": { "description": "FAQ question: Live routing behavior." },
  "helpFaqLiveRoutingAns": "Because the app operates 100% offline, it hands the URL directly to the YouTube app. If the channel is streaming, YouTube loads the stream. If not, YouTube will show scheduled streams, recent videos, or the channel's main tab.",
  "@helpFaqLiveRoutingAns": { "description": "FAQ answer: Live routing behavior." },
  "helpFaqChannelHome": "How do I link directly to a channel page instead of /live?",
  "@helpFaqChannelHome": { "description": "FAQ question: Channel homepage link." },
  "helpFaqChannelHomeAns": "To open the channel home page rather than the live stream, enter the full URL: https://www.youtube.com/@ChannelHandle.",
  "@helpFaqChannelHomeAns": { "description": "FAQ answer: Channel homepage link." },

  "helpQrSharingTitle": "Air-Gapped QR Transfer",
  "@helpQrSharingTitle": { "description": "AppBar title for QR Sharing help screen." },
  "helpQrSharingIntro": "Share shortcuts and migrate your entire collection between devices with zero cables, internet, or cloud servers.",
  "@helpQrSharingIntro": { "description": "Intro text for QR Sharing help screen." },
  "helpSecSingleQr": "Sharing Individual Shortcuts",
  "@helpSecSingleQr": { "description": "Section header for Single QR in help guide." },
  "helpFaqShareSingle": "How do I share a single shortcut via QR code?",
  "@helpFaqShareSingle": { "description": "FAQ question: Single QR sharing." },
  "helpFaqShareSingleAns": "Open the shortcut's detail screen or long-press on a shortcut card and tap the QR icon. An air-gapped QR code containing the shortcut name and destination URL will appear. Any device can scan it to save or open the link.",
  "@helpFaqShareSingleAns": { "description": "FAQ answer: Single QR sharing." },
  "helpSecBulkQr": "Animated Multi-Frame Backup Streaming",
  "@helpSecBulkQr": { "description": "Section header for Bulk QR in help guide." },
  "helpFaqAnimatedQr": "How does animated QR backup work?",
  "@helpFaqAnimatedQr": { "description": "FAQ question: Animated QR backup." },
  "helpFaqAnimatedQrAns": "Under Settings → Backup & Restore, tap 'Export via QR code'. The app chunks your entire shortcut collection and settings into an animated sequence of QR codes. On your new phone, open the Offline QR Scanner and hold the camera steady to assemble the full backup.",
  "@helpFaqAnimatedQrAns": { "description": "FAQ answer: Animated QR backup." },
  "helpFaqGalleryScan": "Can I scan a QR code from a screenshot or photo?",
  "@helpFaqGalleryScan": { "description": "FAQ question: Gallery QR scanning." },
  "helpFaqGalleryScanAns": "Yes! Open the in-app scanner and tap 'Scan Image from Gallery' to select any screenshot or photo containing a YouTube QR code. The image is processed entirely on-device using local vision ML kit.",
  "@helpFaqGalleryScanAns": { "description": "FAQ answer: Gallery QR scanning." },

